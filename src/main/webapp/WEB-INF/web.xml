    <!-- ======================================================= -->
    <!-- CONFIGURATION GENERALE -->
    <!-- ======================================================= -->

    <welcome-file-list>
        <welcome-file>views/login.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>